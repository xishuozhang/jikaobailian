page { background: #ffffff; }
.page { min-height: 100vh; padding: 24rpx 36rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #303640; }
.page-title { font-size: 40rpx; font-weight: 700; line-height: 1.4; color: #242932; }
.page-desc { margin-top: 10rpx; color: #858d98; font-size: 25rpx; line-height: 1.6; }
.state-card { padding: 70rpx 12rpx; color: #858d98; font-size: 27rpx; line-height: 1.7; text-align: center; }
.record-card, .question-card { padding: 30rpx 0; border-bottom: 10rpx solid #f6f7f9; }
.record-card:last-child, .question-card:last-child { border-bottom: 0; }
.question-meta, .record-head { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.record-head { justify-content: space-between; }
.question-number { color: #919ba7; font-size: 28rpx; font-weight: 600; }
.type-tag { color: #418bc9; background: #edf6ff; padding: 5rpx 12rpx; font-size: 22rpx; border-radius: 6rpx; line-height: 1.5; }
.question-title { margin-top: 22rpx; font-size: 31rpx; font-weight: 600; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.question-image { width: 100%; margin-top: 22rpx; border-radius: 12rpx; }
.answer-summary { display: flex; flex-wrap: wrap; gap: 20rpx 32rpx; margin-top: 26rpx; padding: 22rpx 0; border-top: 1rpx solid #edf0f3; border-bottom: 1rpx solid #edf0f3; }
.answer-line { display: flex; flex: 1 1 240rpx; align-items: baseline; gap: 18rpx; font-size: 28rpx; line-height: 1.6; min-width: 0; }
.answer-label { flex-shrink: 0; color: #858d98; font-size: 24rpx; }
.answer-value { min-width: 0; font-weight: 600; overflow-wrap: anywhere; }
.right { color: #289675; }
.wrong { color: #d9675a; }
.analysis-box { padding: 24rpx 0 8rpx; }
.analysis-label { color: #303640; font-size: 26rpx; font-weight: 600; padding-left: 14rpx; border-left: 5rpx solid #3994e5; line-height: 1.2; }
.analysis-text { margin-top: 16rpx; color: #697480; font-size: 27rpx; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; }
.date { font-size: 22rpx; color: #939ca7; line-height: 1.6; }
.result-tag, .mastery-status { font-size: 23rpx; line-height: 1.5; }
.result-tag { margin-left: auto; }
