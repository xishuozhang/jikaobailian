page {
  background: #ffffff;
}

.page {
  min-height: 100vh;
  padding: 24rpx 36rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card,
.question-card,
.analysis-card,
.state-card,
.score-card,
.stat-item {
  border: 1rpx solid #e4ebf5;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
  border: 0;
  border-radius: 0;
  margin-bottom: 12rpx;
}

.topbar-main {
  min-width: 0;
}

.page-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-desc {
  margin-top: 12rpx;
  color: #6b7688;
  font-size: 27rpx;
  line-height: 1.6;
}

.progress {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2F80ED;
  font-size: 24rpx;
  font-weight: 600;
}

.progress-track {
  height: 6rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  background: #e8edf6;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #2F80ED;
}

.question-card,
.analysis-card,
.state-card {
  padding: 30rpx;
}

.state-card {
  color: #6b7688;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-state {
  text-align: center;
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 600;
}

.type-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.type-tag.blue {
  background: #eaf2ff;
  color: #2F80ED;
}

.question-title {
  margin-top: 18rpx;
  color: #172033;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.62;
}

.question-image {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 16rpx;
}

.question-card {
  border: 0;
  border-radius: 0;
  padding: 20rpx 0;
}

.options {
  margin-top: 30rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  padding: 24rpx 22rpx;
  border: 2rpx solid #e4e9f2;
  border-radius: 16rpx;
  background: #f8fafc;
}

.option:active {
  background: #f8fbff;
}

.option.selected {
  border-color: #2F80ED;
  background: #eef5ff;
}

.option-key {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #eef1f6;
  color: #536071;
  font-size: 24rpx;
  font-weight: 600;
}

.option.selected .option-key {
  background: #2F80ED;
  color: #ffffff;
}

.option-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  margin-left: 18rpx;
  color: #263044;
  font-size: 29rpx;
  line-height: 1.55;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.nav-btn,
.primary-btn {
  height: 88rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.nav-btn {
  flex: 1;
  border: 1rpx solid #dce5f2;
  background: #ffffff;
  color: #405064;
}

.primary-btn {
  flex: 1.4;
  background: #2F80ED;
  color: #ffffff;
}

.score-card {
  padding: 38rpx 34rpx;
  background: #2F80ED;
  color: #ffffff;
}

.score {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.score-desc {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 27rpx;
}

.stats {
  display: flex;
  gap: 18rpx;
  margin: 26rpx 0 34rpx;
}

.stat-item {
  flex: 1;
  padding: 24rpx 12rpx;
  text-align: center;
}

.stat-value {
  color: #172033;
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: #7b8496;
  font-size: 24rpx;
}

.good .stat-value {
  color: #14a46c;
}

.bad .stat-value {
  color: #e35d5d;
}

.section-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.analysis-card {
  margin-bottom: 20rpx;
}

.result-option-list {
  margin-top: 18rpx;
}

.result-option {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e4ebf5;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #405064;
  box-sizing: border-box;
}

.result-option.is-wrong {
  border-color: #f2b7ae;
  background: #fff4f1;
  color: #b94f43;
}

.result-option.is-correct {
  border-color: #a8d9bd;
  background: #f1fbf5;
  color: #2f7d55;
}

.result-option-main {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.result-option-key {
  flex: 0 0 auto;
  min-width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.1);
  color: #2F80ED;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
}

.result-option.is-wrong .result-option-key {
  background: #f8d6d0;
  color: #b94f43;
}

.result-option.is-correct .result-option-key {
  background: #d7f0df;
  color: #2f7d55;
}

.result-option-text {
  min-width: 0;
  color: inherit;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-all;
}

.result-option-badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  color: inherit;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.answer-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.answer-label {
  flex: 0 0 auto;
  margin-right: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.answer-line.wrong {
  color: #d94f4f;
}

.answer-line.wrong .answer-label {
  background: #d94f4f;
}

.answer-line.right {
  color: #159262;
}

.answer-line.right .answer-label {
  background: #159262;
}

.analysis-text {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f0f6ff;
  color: #405064;
  font-size: 27rpx;
  line-height: 1.65;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 30rpx;
}

.result-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
  letter-spacing: 0;
  box-shadow: 0 12rpx 24rpx rgba(37, 64, 103, 0.08);
}

.result-btn::after {
  border: 0;
}

.result-btn-home {
  border: 1rpx solid #d9e4f1;
  background: #ffffff;
  color: #405064;
}

.result-btn-mistakes {
  border: 1rpx solid #f0c8bd;
  background: #fff4f1;
  color: #b85b4b;
}

.result-btn-retry {
  border: 0;
  background: #2589e8;
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(47, 128, 237, 0.24);
}

.result-btn-home:active {
  background: #f6f9fd;
}

.result-btn-mistakes:active {
  background: #fde9e4;
}

.result-btn-retry:active {
  background: #177bd5;
}
