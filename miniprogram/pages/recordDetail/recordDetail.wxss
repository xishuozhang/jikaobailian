@import "../../styles/review.wxss";
.report-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding: 12rpx 0 28rpx; }
.report-type { color: #7b8793; font-size: 24rpx; }
.score-card { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24rpx; padding: 28rpx 30rpx; background: #edf7ff; border-radius: 16rpx; }
.eyebrow { color: #6e95b5; font-size: 24rpx; }
.score { margin-top: 8rpx; color: #2589e8; font-size: 76rpx; line-height: 1.2; font-weight: 700; }
.score-unit { font-size: 25rpx; font-weight: 400; margin-left: 10rpx; }
.report-meta { min-width: 0; }
.score-desc { color: #7890a3; font-size: 23rpx; line-height: 1.8; overflow-wrap: anywhere; }
.stats { display: flex; margin: 30rpx 0; padding: 8rpx 0; }
.stat-item { flex: 1; min-width: 0; text-align: center; }
.stat-item + .stat-item { border-left: 1rpx solid #edf0f3; }
.stat-value { color: #303640; font-size: 38rpx; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.stat-label { color: #929ba5; font-size: 23rpx; margin-top: 8rpx; }
.good .stat-value { color: #289675; }
.bad .stat-value { color: #d9675a; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 -36rpx; padding: 28rpx 36rpx 12rpx; border-top: 12rpx solid #f6f7f9; }
.section-title { color: #303640; font-size: 32rpx; font-weight: 600; }
.section-note { color: #939ca7; font-size: 23rpx; }
