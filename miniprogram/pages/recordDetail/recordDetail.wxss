page {
  background: #F5F7FB;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 48rpx;
  box-sizing: border-box;
}

.score-card,
.stat-item,
.question-card,
.state-card {
  border: 1rpx solid #e4ebf5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(37, 64, 103, 0.06);
  box-sizing: border-box;
}

.score-card {
  padding: 38rpx 34rpx;
  background: #2F80ED;
  color: #ffffff;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 600;
}

.score {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.score-desc {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 27rpx;
}

.stats {
  display: flex;
  gap: 18rpx;
  margin: 26rpx 0 34rpx;
}

.stat-item {
  flex: 1;
  padding: 24rpx 12rpx;
  text-align: center;
}

.stat-value {
  color: #172033;
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: #7b8496;
  font-size: 24rpx;
}

.good .stat-value {
  color: #14a46c;
}

.bad .stat-value {
  color: #e35d5d;
}

.section-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.question-card,
.state-card {
  padding: 30rpx;
}

.question-card {
  margin-bottom: 20rpx;
}

.state-card {
  color: #6b7688;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-state {
  text-align: center;
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-tag,
.result-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.type-tag {
  background: #eef3fb;
  color: #64748b;
}

.type-tag.blue {
  background: #eaf2ff;
  color: #2F80ED;
}

.result-tag.right {
  background: #e8f8f1;
  color: #159262;
}

.result-tag.wrong {
  background: #fff0ee;
  color: #d65348;
}

.question-title {
  margin-top: 18rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.6;
}

.question-image {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: #f5f7fb;
}

.answer-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.answer-label {
  flex: 0 0 auto;
  margin-right: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.answer-line.wrong {
  color: #d65348;
}

.answer-line.wrong .answer-label {
  background: #d65348;
}

.answer-line.right {
  color: #159262;
}

.answer-line.right .answer-label {
  background: #159262;
}

.analysis-text {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f0f6ff;
  color: #405064;
  font-size: 27rpx;
  line-height: 1.65;
}
