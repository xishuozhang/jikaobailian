page {
  background: #ffffff;
}

.page {
  min-height: 100vh;
  padding: 24rpx 36rpx 48rpx;
  box-sizing: border-box;
}

.profile-card,
.account-card,
.menu-list {
  border: 0;
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 24rpx 0 44rpx;
}

.avatar {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #e8edf5;
}

.profile-main {
  min-width: 0;
  margin-left: 22rpx;
}

.profile-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.page-title {
  color: #172033;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-all;
}

.member-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.member-tag.normal {
  background: #eef3fb;
  color: #64748b;
}

.member-tag.vip {
  background: #fff3d8;
  color: #9a6100;
}

.openid-text,
.member-expire {
  margin-top: 10rpx;
  color: #6b7688;
  font-size: 25rpx;
  line-height: 1.45;
  word-break: break-all;
}

.member-expire {
  color: #405064;
}

.account-card {
  margin: 0 -36rpx;
  padding: 32rpx 36rpx;
  border-top: 12rpx solid #f6f7f9;
}

.section-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.menu-list {
  overflow: hidden;
  box-shadow: none;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  gap: 20rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #edf1f6;
}

.menu-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.menu-desc {
  margin-top: 8rpx;
  color: #718096;
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-arrow {
  color: #9aa3b3;
  font-size: 42rpx;
  line-height: 1;
}

.edit-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.edit-panel {
  width: 100%;
  padding: 34rpx 34rpx 48rpx;
  border-radius: 16rpx 16rpx 0 0;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.edit-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 34rpx;
}

.avatar-preview {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #e8edf5;
}

.avatar-button {
  margin: 0;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #2f6bff;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.avatar-button::after,
.cancel-button::after,
.save-button::after {
  border: 0;
}

.form-item {
  margin-top: 36rpx;
}

.form-label {
  margin-bottom: 14rpx;
  color: #405064;
  font-size: 28rpx;
  font-weight: 700;
}

.nickname-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9e2ef;
  border-radius: 14rpx;
  background: #f9fbff;
  color: #172033;
  font-size: 30rpx;
  box-sizing: border-box;
}

.edit-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 44rpx;
}

.cancel-button,
.save-button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.cancel-button {
  background: #eef3fb;
  color: #405064;
}

.save-button {
  background: #2f6bff;
  color: #ffffff;
}
