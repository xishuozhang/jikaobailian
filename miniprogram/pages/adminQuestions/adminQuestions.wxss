@import "../admin/admin.wxss";

.filter-card,
.question-card {
  border: 1rpx solid #e4ebf5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(37, 64, 103, 0.06);
  box-sizing: border-box;
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.input {
  height: 82rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 14rpx;
  background: #ffffff;
  color: #172033;
  font-size: 28rpx;
  box-sizing: border-box;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.nav-btn,
.primary-btn,
.danger-btn {
  height: 78rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.nav-btn {
  flex: 1;
  border: 1rpx solid #dce5f2;
  background: #ffffff;
  color: #405064;
}

.primary-btn {
  flex: 1;
  background: #2F80ED;
  color: #ffffff;
}

.danger-btn {
  flex: 1;
  background: #fff0ee;
  color: #d65348;
}

.add-btn {
  margin-bottom: 22rpx;
}

.question-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.55;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2F80ED;
  font-size: 23rpx;
  font-weight: 600;
}
