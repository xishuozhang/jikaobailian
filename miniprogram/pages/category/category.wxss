page {
  background: #F5F7FB;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 48rpx;
  box-sizing: border-box;
}

.header-card,
.state-card,
.category-card {
  border: 1rpx solid #e4ebf5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(37, 64, 103, 0.06);
  box-sizing: border-box;
}

.header-card,
.state-card,
.category-card {
  padding: 30rpx;
}

.header-card {
  margin-bottom: 24rpx;
}

.page-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-desc {
  margin-top: 12rpx;
  color: #6b7688;
  font-size: 27rpx;
  line-height: 1.6;
}

.state-card {
  color: #6b7688;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-card:active {
  background: #f8fbff;
}

.category-name {
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.category-desc {
  margin-top: 10rpx;
  color: #718096;
  font-size: 25rpx;
}

.start-tag {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2F80ED;
  font-size: 24rpx;
  font-weight: 700;
}
