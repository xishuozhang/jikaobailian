<view class="page">
  <view class="header-card">
    <view class="page-title">分类练习</view>
    <view class="page-desc">专项突破 · 每组最多 10 题</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在读取分类...</view>
  <view wx:elif="{{!categories.length}}" class="state-card">暂无分类题目，请先导入题库。</view>

  <view wx:else class="category-list">
    <view
      wx:for="{{categories}}"
      wx:key="name"
      class="category-card"
      data-category="{{item.name}}"
      bindtap="goPractice"
    >
      <view class="category-number">{{index + 1}}</view>
      <view class="category-copy">
        <view class="category-name">{{item.name}}</view>
        <view class="category-desc">已练习 <text class="practiced-count">{{item.practicedText}}</text><text class="progress-total"> / {{item.count}}</text> 题</view>
      </view>
      <view class="start-tag">›</view>
    </view>
  </view>
</view>
