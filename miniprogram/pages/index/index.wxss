page { background: #ffffff; }
.home-page { padding: 24rpx 36rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); color: #23272f; box-sizing: border-box; }
.home-heading, .daily-top, .section-heading, .training-row, .home-footer { display: flex; align-items: center; justify-content: space-between; }
.home-heading { margin-bottom: 30rpx; }
.home-subject { font-size: 24rpx; color: #7a828e; margin-bottom: 10rpx; }
.home-title { font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.profile-link { display: flex; flex-direction: column; align-items: center; padding: 8rpx 12rpx; color: #6c7581; font-size: 22rpx; }
.profile-icon { width: 42rpx; height: 42rpx; margin-bottom: 6rpx; }
.learning-overview { display: flex; padding: 10rpx 0 32rpx; }
.overview-item { flex: 1; min-width: 0; text-align: center; }
.overview-item + .overview-item { border-left: 1rpx solid #edf0f3; }
.overview-value { color: #242932; font-size: 38rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.overview-value.coral { color: #df7955; }
.overview-label { color: #848b96; font-size: 23rpx; margin-top: 6rpx; }
.stats-retry { text-align: center; color: #737d88; font-size: 23rpx; padding-bottom: 20rpx; }
.daily-practice { background: #edf7ff; border-radius: 16rpx; padding: 28rpx 30rpx; }
.daily-label { color: #257fc9; font-size: 24rpx; font-weight: 600; }
.daily-tag { color: #6f97b6; font-size: 22rpx; }
.daily-title { font-size: 36rpx; font-weight: 700; line-height: 1.45; margin-top: 16rpx; }
.daily-desc { font-size: 23rpx; color: #738699; margin-top: 8rpx; line-height: 1.6; }
.start-practice { background: #2589e8; color: #ffffff; border-radius: 12rpx; font-size: 29rpx; font-weight: 600; line-height: 80rpx; margin-top: 26rpx; width: 100%; }
.button-arrow { margin-left: 18rpx; font-size: 34rpx; }
.quick-tools { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 34rpx 0; gap: 12rpx; }
.quick-tool { display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #414853; line-height: 1.5; }
.tool-icon { width: 76rpx; height: 76rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 14rpx; }
.tool-icon image { width: 42rpx; height: 42rpx; }
.blue { background: #eef6ff; color: #428cdb; }
.green { background: #eaf7f1; color: #37a080; }
.peach { background: #fff2e9; color: #df8a52; }
.violet { background: #f2f0fc; color: #8d7dbb; }
.training-section { border-top: 12rpx solid #f6f7f9; margin: 0 -36rpx; padding: 28rpx 36rpx 0; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-caption { font-size: 22rpx; color: #959ba4; }
.section-heading { gap: 16rpx; margin-bottom: 12rpx; }
.training-row { padding: 28rpx 0; gap: 20rpx; border-bottom: 1rpx solid #f0f1f3; }
.row-marker { flex: 0 0 62rpx; height: 62rpx; border-radius: 12rpx; text-align: center; line-height: 62rpx; font-size: 25rpx; font-weight: 600; }
.training-copy { flex: 1; min-width: 0; }
.training-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.training-desc { font-size: 23rpx; color: #9097a1; margin-top: 8rpx; line-height: 1.5; }
.row-arrow { font-size: 36rpx; color: #b5bdc6; flex-shrink: 0; }
.member-label { display: inline-block; vertical-align: middle; font-size: 19rpx; font-weight: 400; color: #ad7b35; background: #fff4dc; padding: 2rpx 8rpx; border-radius: 4rpx; margin-left: 12rpx; }
.home-footer { gap: 14rpx; flex-wrap: wrap; font-size: 22rpx; color: #a0a6af; padding-top: 28rpx; }
.share-button { margin: 0; font-size: 22rpx; color: #428ac9; line-height: 2; }
.training-row:active, .quick-tool:active, .profile-link:active { opacity: 0.65; }
.start-practice:active { background: #177bd5; }
.pk-entry { display: flex; align-items: center; gap: 22rpx; padding: 8rpx 0 30rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid #edf0f3; }
.pk-entry-mark { flex: 0 0 66rpx; height: 66rpx; line-height: 66rpx; text-align: center; border-radius: 12rpx; color: #398ddd; background: #edf6ff; font-size: 27rpx; font-weight: 800; font-style: italic; }
