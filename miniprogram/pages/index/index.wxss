page {
  background: #f4f7fc;
}

.home-page {
  min-height: 100vh;
  padding: 44rpx 30rpx 48rpx;
  box-sizing: border-box;
}

.welcome-card {
  margin-bottom: 34rpx;
  padding: 36rpx 34rpx;
  border: 1rpx solid #e4ebf5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(37, 64, 103, 0.08);
}

.welcome-kicker {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2f7cf6;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.title {
  margin-top: 22rpx;
  color: #172033;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 12rpx;
  color: #6b7688;
  font-size: 28rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.section-note {
  color: #8a96a8;
  font-size: 24rpx;
  line-height: 1.4;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.entry-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 226rpx;
  padding: 26rpx;
  border: 1rpx solid #e4ebf5;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(37, 64, 103, 0.06);
  box-sizing: border-box;
}

.entry-card:active {
  background: #f8fbff;
  transform: translateY(1rpx);
}

.entry-main {
  width: 100%;
  min-width: 0;
}

.entry-title-row {
  display: flex;
  align-items: center;
  min-height: 42rpx;
}

.entry-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.vip-tag {
  margin-left: 14rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #fff3d8;
  color: #9a6100;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}

.entry-desc {
  margin-top: 12rpx;
  color: #718096;
  font-size: 24rpx;
  line-height: 1.5;
}

.entry-action {
  align-self: flex-start;
  margin-top: 22rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #2f7cf6;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.3;
}
