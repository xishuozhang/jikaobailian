<view class="home-page">
  <view class="home-heading">
    <view><view class="home-subject">中职 · 数字媒体</view><view class="home-title">题库练习</view></view>
    <view class="profile-link" data-url="/pages/profile/index" bindtap="goPage" aria-label="个人中心">
      <image src="/images/icons/usercenter-active.png" class="profile-icon" mode="aspectFit" /><text>我的</text>
    </view>
  </view>
  <view class="learning-overview" data-url="/pages/study/study" bindtap="goPage">
    <view class="overview-item"><view class="overview-value">{{statsLoading || statsError ? '--' : totalQuestionCount}}</view><view class="overview-label">累计做题</view></view>
    <view class="overview-item"><view class="overview-value">{{statsLoading || statsError ? '--' : accuracyText}}</view><view class="overview-label">正确率</view></view>
    <view class="overview-item"><view class="overview-value coral">{{statsLoading || statsError ? '--' : unmasteredWrongCount}}</view><view class="overview-label">待巩固错题</view></view>
  </view>
  <view wx:if="{{statsError}}" class="stats-retry" bindtap="loadStats">学习数据暂未加载，点击重试</view>
  <view class="daily-practice">
    <view class="daily-top"><text class="daily-label">随机一练</text><text class="daily-tag">日常积累</text></view>
    <view class="daily-title">现在，开始一组练习</view>
    <view class="daily-desc">随机抽题 · 即时解析 · 错题归档</view>
    <button class="start-practice" data-url="/pages/randomPractice/index" bindtap="goPage">开始刷题<text class="button-arrow">›</text></button>
  </view>
  <view class="quick-tools">
    <view class="quick-tool" data-url="/pages/category/category" bindtap="goPage"><view class="tool-icon blue"><image src="/images/icons/examples-active.png" mode="aspectFit" /></view><text>分类练习</text></view>
    <view class="quick-tool" data-url="/pages/mockPractice/index" bindtap="goPage"><view class="tool-icon green"><image src="/images/icons/business-active.png" mode="aspectFit" /></view><text>模拟练习</text></view>
    <view class="quick-tool" data-url="/pages/mistakes/index" bindtap="goPage"><view class="tool-icon peach"><image src="/images/icons/question.svg" mode="aspectFit" /></view><text>错题本</text></view>
    <view class="quick-tool" data-url="/pages/study/study" bindtap="goPage"><view class="tool-icon violet"><image src="/images/icons/goods-active.png" mode="aspectFit" /></view><text>学习记录</text></view>
  </view>
  <view class="training-section">
    <view class="pk-entry" data-url="/pages/friendPk/index" bindtap="goPage"><view class="pk-entry-mark">VS</view><view class="training-copy"><view class="training-title">好友 PK</view><view class="training-desc">同题限时挑战，邀请好友一较高下</view></view><text class="row-arrow">›</text></view>
    <view class="section-heading"><text class="section-title">专项提升</text><text class="section-caption">练习 · 复盘 · 巩固</text></view>
    <view class="training-row" data-url="/pages/category/category" bindtap="goPage"><view class="row-marker blue">01</view><view class="training-copy"><view class="training-title">按知识点逐个突破</view><view class="training-desc">分类训练，巩固每一个知识点</view></view><text class="row-arrow">›</text></view>
    <view class="training-row" data-url="/pages/wrongPractice/wrongPractice" bindtap="goPage"><view class="row-marker peach">02</view><view class="training-copy"><view class="training-title">把错题变成得分题</view><view class="training-desc">复习未掌握题目，查漏补缺</view></view><text class="row-arrow">›</text></view>
    <view class="training-row" data-url="/pages/mockPractice/index" bindtap="goPage"><view class="row-marker green">03</view><view class="training-copy"><view class="training-title">模拟练习<text class="member-label">会员</text></view><view class="training-desc">完整练习，检验阶段学习成果</view></view><text class="row-arrow">›</text></view>
  </view>
  <view class="home-footer"><text>积少成多，每一题都算数</text><button open-type="share" class="share-button">分享给同学</button></view>
</view>
