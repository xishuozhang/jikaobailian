page {
  background: #F5F7FB;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 48rpx;
  box-sizing: border-box;
}

.header-card,
.practice-entry-card,
.state-card,
.record-card {
  border: 1rpx solid #e4ebf5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(37, 64, 103, 0.06);
  box-sizing: border-box;
}

.header-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.practice-entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
}

.practice-entry-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.practice-entry-desc {
  margin-top: 8rpx;
  color: #6b7688;
  font-size: 24rpx;
  line-height: 1.45;
}

.practice-entry-btn {
  flex: 0 0 auto;
  width: 160rpx;
  height: 64rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  background: #2F80ED;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.practice-entry-btn[disabled] {
  background: #c7d2e2;
  color: #ffffff;
}

.page-title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-desc {
  margin-top: 12rpx;
  color: #6b7688;
  font-size: 27rpx;
  line-height: 1.6;
}

.count {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0ee;
  color: #d65348;
  font-size: 24rpx;
  font-weight: 700;
}

.state-card,
.record-card {
  padding: 30rpx;
}

.empty-state {
  text-align: center;
  color: #6b7688;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  margin: 14rpx 0 26rpx;
  color: #718096;
  font-size: 27rpx;
}

.primary-btn {
  height: 88rpx;
  border-radius: 14rpx;
  background: #2F80ED;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.record-card {
  margin-bottom: 22rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.type-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2F80ED;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.date {
  color: #9aa3b3;
  font-size: 24rpx;
}

.question-title {
  margin-top: 18rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.6;
}

.question-image {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: #f5f7fb;
}

.option-list {
  margin-top: 18rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e4ebf5;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #405064;
  box-sizing: border-box;
}

.option-item.is-wrong {
  border-color: #f2b7ae;
  background: #fff4f1;
  color: #b94f43;
}

.option-item.is-correct {
  border-color: #a8d9bd;
  background: #f1fbf5;
  color: #2f7d55;
}

.option-main {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.option-key {
  flex: 0 0 auto;
  min-width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.1);
  color: #2F80ED;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
}

.option-item.is-wrong .option-key {
  background: #f8d6d0;
  color: #b94f43;
}

.option-item.is-correct .option-key {
  background: #d7f0df;
  color: #2f7d55;
}

.option-text {
  min-width: 0;
  color: inherit;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-all;
}

.option-badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  color: inherit;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.answer-line {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.answer-line.wrong {
  color: #d94f4f;
}

.answer-line.right {
  color: #159262;
}

.wrong-count {
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0ee;
  color: #d65348;
  font-size: 24rpx;
  font-weight: 600;
}

.analysis-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f0f6ff;
}

.analysis-label {
  color: #2F80ED;
  font-size: 24rpx;
  font-weight: 700;
}

.analysis-text {
  margin-top: 10rpx;
  color: #405064;
  font-size: 27rpx;
  line-height: 1.65;
}
