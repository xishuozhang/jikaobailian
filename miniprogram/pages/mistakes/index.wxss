@import "../../styles/review.wxss";
.header-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 12rpx 0 30rpx; }
.count { flex-shrink: 0; color: #df7955; font-size: 36rpx; font-weight: 600; }
.count-unit { color: #9099a4; font-size: 23rpx; font-weight: 400; }
.practice-entry-card { display: flex; align-items: center; gap: 24rpx; padding: 26rpx; background: #edf7ff; border-radius: 16rpx; margin-bottom: 24rpx; }
.practice-entry-copy { flex: 1; min-width: 0; }
.practice-entry-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; color: #303640; }
.practice-entry-desc { color: #7890a3; font-size: 23rpx; margin-top: 8rpx; line-height: 1.6; }
.practice-entry-btn { flex: 0 0 160rpx; width: 160rpx; height: 68rpx; margin: 0; border-radius: 12rpx; background: #2589e8; color: #ffffff; font-size: 25rpx; line-height: 68rpx; }
.practice-entry-btn[disabled] { background: #dce6ef; color: #8c9baa; }
.status-tabs { display: flex; border-bottom: 1rpx solid #edf0f3; gap: 32rpx; }
.status-tab { flex: 1; min-width: 0; margin: 0; padding: 24rpx 0; color: #8a939f; font-size: 28rpx; line-height: 1.5; border-bottom: 4rpx solid transparent; background: transparent; }
.status-tab.active { color: #2589e8; border-bottom-color: #2589e8; font-weight: 600; }
.pending { color: #ce8a4c; }
.empty-title { color: #46515d; font-size: 30rpx; font-weight: 600; }
.empty-desc { margin: 14rpx 0 30rpx; font-size: 25rpx; color: #919aa5; }
.primary-btn { width: 280rpx; margin: 0 auto; background: #2589e8; color: #ffffff; border-radius: 12rpx; height: 80rpx; line-height: 80rpx; font-size: 27rpx; }
.option-list { margin-top: 24rpx; }
.option-item { display: flex; flex-direction: column; align-items: stretch; gap: 10rpx; padding: 20rpx; margin-top: 12rpx; background: #f7f9fb; border: 1rpx solid #edf0f3; border-radius: 12rpx; color: #596572; }
.option-main { display: flex; gap: 18rpx; min-width: 0; align-items: flex-start; }
.option-key { flex: 0 0 40rpx; min-height: 40rpx; text-align: center; line-height: 40rpx; font-size: 25rpx; font-weight: 600; color: inherit; }
.option-text { min-width: 0; flex: 1; font-size: 27rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.option-badge { align-self: flex-start; margin-left: 58rpx; font-size: 21rpx; color: inherit; line-height: 1.5; }
.option-item.is-wrong { background: #fff5f2; border-color: #f5dcd5; color: #c36b5d; }
.option-item.is-correct { background: #eff9f4; border-color: #d4ebde; color: #328c6d; }
.record-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20rpx; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #edf0f3; }
.review-history { flex: 1 1 200rpx; }
.wrong-count { color: #a17c68; font-size: 23rpx; line-height: 1.5; margin-bottom: 6rpx; }
.mastery-button { flex: 0 0 auto; margin: 0; padding: 0 24rpx; min-width: 200rpx; box-sizing: border-box; height: 70rpx; line-height: 70rpx; border-radius: 12rpx; background: #edf6ff; color: #2985d4; font-size: 25rpx; font-weight: 500; }
.mastery-button.restore { background: #f3f5f7; color: #788391; }
.mastery-button[disabled] { color: #9aa5b0; background: #f1f4f7; }
.mastery-button:active, .practice-entry-btn:active { opacity: 0.75; }
