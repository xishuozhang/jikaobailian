<view class="page">
  <view class="header-card">
    <view>
      <view class="page-title">错题本</view>
      <view class="page-desc">温故知新，把薄弱点逐个掌握</view>
    </view>
    <view class="count">{{loading ? '--' : records.length}}<text class="count-unit"> 题</text></view>
  </view>

  <view class="practice-entry-card">
    <view class="practice-entry-copy">
      <view class="practice-entry-title">只练未掌握错题</view>
      <view class="practice-entry-desc">{{hasUnmasteredWrong ? '集中复习，让知识更牢固' : '暂无未掌握错题'}}</view>
    </view>
    <button class="practice-entry-btn" disabled="{{!hasUnmasteredWrong}}" bindtap="goWrongPractice">开始练习</button>
  </view>

  <view class="status-tabs">
    <button
      wx:for="{{statusTabs}}"
      wx:key="key"
      class="status-tab {{activeStatus === item.key ? 'active' : ''}}"
      data-status="{{item.key}}"
      bindtap="switchStatus"
    >{{item.text}}</button>
  </view>

  <view wx:if="{{loading}}" class="state-card empty-state">正在整理错题...</view>
  <view wx:elif="{{!records.length}}" class="state-card empty-state">
    <view class="empty-title">{{activeStatus === 'mastered' ? '还没有已掌握的错题' : activeStatus === 'unmastered' ? '暂无待巩固错题' : '暂无错题记录'}}</view>
    <view class="empty-desc">{{activeStatus === 'mastered' ? '复习后标记已掌握，进步会留在这里。' : '继续练习，积累新的进步。'}}</view>
    <button class="primary-btn" bindtap="goPractice">去随机一练</button>
  </view>

  <view wx:else class="record-list">
    <view wx:for="{{records}}" wx:key="_id" class="record-card">
      <view class="record-head">
        <view class="question-meta"><text class="question-number">{{index + 1}}.</text><view class="type-tag">{{item.typeText}}</view></view>
        <view class="mastery-status {{item.mastered ? 'right' : 'pending'}}">{{item.statusText}}</view>
      </view>
      <view class="question-title">{{item.title}}</view>
      <image wx:if="{{item.imageUrl}}" class="question-image" src="{{item.imageUrl}}" mode="widthFix"></image>
      <view wx:if="{{item.optionItems.length}}" class="option-list">
        <view wx:for="{{item.optionItems}}" wx:for-item="option" wx:key="key" class="{{option.className}}">
          <view class="option-main">
            <view class="option-key">{{option.key}}</view>
            <view class="option-text">{{option.text}}</view>
          </view>
          <view wx:if="{{option.badgeText}}" class="option-badge">{{option.badgeText}}</view>
        </view>
      </view>
      <view class="answer-summary">
        <view class="answer-line wrong"><text class="answer-label">你的答案</text><text class="answer-value">{{item.selectedText}}</text></view>
        <view class="answer-line right"><text class="answer-label">正确答案</text><text class="answer-value">{{item.correctText}}</text></view>
      </view>
      <view class="analysis-box">
        <view class="analysis-label">答案解析</view>
        <view class="analysis-text">{{item.analysis}}</view>
      </view>
      <view class="record-footer">
        <view class="review-history"><view class="wrong-count">累计答错 {{item.wrongCount}} 次</view><view wx:if="{{item.dateText}}" class="date">最近 {{item.dateText}}</view></view>
        <button
          class="mastery-button {{item.mastered ? 'restore' : ''}}"
          loading="{{operating}}"
          disabled="{{operating}}"
          data-id="{{item._id}}"
          data-question-id="{{item.questionId}}"
          data-action="{{item.actionName}}"
          bindtap="toggleMastered"
        >{{item.actionText}}</button>
      </view>
    </view>
  </view>
</view>
